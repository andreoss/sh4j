<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sh4j</groupId>
    <artifactId>sh4j</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>sh4j - POSIX shell in Java</name>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>4.13.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
<plugin>
<groupId>org.apache.maven.plugins</groupId>
<artifactId>maven-compiler-plugin</artifactId>
<version>3.11.0</version>
<configuration>
<source>1.8</source>
<target>1.8</target>
</configuration>
</plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.github.andreoss.sh4j.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <configuration>
                    <excludes>
                        <exclude>**/errorprone-classes/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                <execution>
                    <goals>
                        <goal>prepare-agent</goal>
                    </goals>
                </execution>
                <execution>
                    <id>report</id>
                    <phase>test</phase>
                    <goals>
                        <goal>report</goal>
                    </goals>
                </execution>
                <execution>
                    <id>jacoco-check</id>
                    <phase>verify</phase>
                    <goals>
                        <goal>check</goal>
                    </goals>
                    <configuration>
                        <rules>
                            <rule>
                                <element>BUNDLE</element>
                                <limits>
                                    <limit>
                                        <counter>INSTRUCTION</counter>
                                        <minimum>0.99</minimum>
                                    </limit>
                                </limits>
                            </rule>
                            <rule>
                                <element>PACKAGE</element>
                                <includes>
                                    <include>io.github.andreoss.sh4j</include>
                                </includes>
                                <limits>
                                    <limit>
                                        <counter>INSTRUCTION</counter>
                                        <minimum>0.99</minimum>
                                    </limit>
                                </limits>
                            </rule>
                             <rule>
                                 <element>PACKAGE</element>
                                 <includes>
                                     <include>io.github.andreoss.sh4j.lexer</include>
                                 </includes>
                                 <limits>
                                     <limit>
                                         <counter>INSTRUCTION</counter>
                                         <minimum>0.99</minimum>
                                     </limit>
                                 </limits>
                             </rule>
                            <rule>
                                <element>PACKAGE</element>
                                <includes>
                                    <include>io.github.andreoss.sh4j.parser</include>
                                </includes>
                                <limits>
                                    <limit>
                                        <counter>INSTRUCTION</counter>
                                        <minimum>0.98</minimum>
                                    </limit>
                                </limits>
                            </rule>
                            <rule>
                                <element>PACKAGE</element>
                                <includes>
                                    <include>io.github.andreoss.sh4j.executor</include>
                                </includes>
                                <limits>
                                    <limit>
                                        <counter>INSTRUCTION</counter>
                                        <minimum>0.98</minimum>
                                    </limit>
                                </limits>
                            </rule>
                        </rules>
                    </configuration>
                </execution>
            </executions>
        </plugin>
            <plugin>
                <groupId>com.qulice</groupId>
                <artifactId>qulice-maven-plugin</artifactId>
                <version>0.27.6</version>
                <configuration>
                    <license>none</license>
                    <excludes>
                        <exclude>checkstyle:.*/sh4j/lexer/Lexer\.java</exclude>
                        <exclude>checkstyle:.*/sh4j/parser/Parser\.java</exclude>
                        <exclude>checkstyle:.*/sh4j/executor/ArithmeticEvaluator\.java</exclude>
                        <exclude>checkstyle:.*/sh4j/executor/BuiltinDispatcher\.java</exclude>
                        <exclude>checkstyle:.*/sh4j/executor/Executor\.java</exclude>
                        <exclude>checkstyle:.*/sh4j/executor/RedirectionHandler\.java</exclude>
                        <exclude>checkstyle:.*/sh4j/executor/WordExpander\.java</exclude>
                        <exclude>pmd:.*/sh4j/lexer/Lexer\.java</exclude>
                        <exclude>pmd:.*/sh4j/parser/Parser\.java</exclude>
                        <exclude>pmd:.*/sh4j/executor/ArithmeticEvaluator\.java</exclude>
                        <exclude>pmd:.*/sh4j/executor/BuiltinDispatcher\.java</exclude>
                        <exclude>pmd:.*/sh4j/executor/Executor\.java</exclude>
                        <exclude>pmd:.*/sh4j/executor/RedirectionHandler\.java</exclude>
                        <exclude>pmd:.*/sh4j/executor/WordExpander\.java</exclude>
                         <exclude>checkstyle:.*/src/main/java/.*</exclude>
                         <exclude>pmd:.*/src/main/java/io/github/andreoss/sh4j/Main\.java</exclude>
                         <exclude>pmd:.*/src/main/java/io/github/andreoss/sh4j/executor/JobManager\.java</exclude>
                         <exclude>pmd:.*/src/main/java/io/github/andreoss/sh4j/executor/CommandHistory\.java</exclude>
                         <exclude>pmd:.*/src/main/java/io/github/andreoss/sh4j/parser/Node\.java</exclude>
                         <exclude>pmd:.*/src/main/java/io/github/andreoss/sh4j/executor/BuiltinContext\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/executor/Executor\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/executor/BuiltinContext\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/executor/BuiltinDispatcher\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/executor/WordExpander\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/executor/CommandHistory\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/executor/JobManager\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/SimpleCommand\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/Redirection\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/CaseNode\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/WhileNode\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/IfNode\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/ForNode\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/Pipeline\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/Parser\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/ListNode\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/FunctionNode\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/Subshell\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/parser/Grouping\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/lexer/Token\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/lexer/CharReader\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/lexer/TokenType\.java</exclude>
                         <exclude>errorprone:.*/src/main/java/io/github/andreoss/sh4j/Main\.java</exclude>
                         <exclude>errorprone:.*/src/test/java/.*</exclude>
                         <exclude>pmd:.*/src/test/java/.*</exclude>
                        <exclude>checkstyle:.*ExecutorTest\.java</exclude>
                         <exclude>checkstyle:.*/IntegrationTest\.java</exclude>
                         <exclude>checkstyle:.*/CommandHistoryTest\.java</exclude>
                         <exclude>checkstyle:.*/MainTest\.java</exclude>
                        <exclude>checkstyle:.*/PosixConformanceTest\.java</exclude>
                        <exclude>checkstyle:.*/PosixTests\.java</exclude>
                        <exclude>checkstyle:.*/ArithmeticEvaluatorTest\.java</exclude>
                        <exclude>checkstyle:.*/BuiltinDispatcherTest\.java</exclude>
                        <exclude>checkstyle:.*/RedirectionHandlerTest\.java</exclude>
                        <exclude>checkstyle:.*/WordExpanderTest\.java</exclude>
                        <exclude>checkstyle:.*/CharReaderTest\.java</exclude>
                        <exclude>checkstyle:.*/LexerTest\.java</exclude>
                        <exclude>checkstyle:.*/TokenTest\.java</exclude>
                        <exclude>checkstyle:.*/TokenTypeTest\.java</exclude>
                        <exclude>checkstyle:.*/ParserTest\.java</exclude>
                        <exclude>checkstyle:.*/Sh4j\.java</exclude>
                        <exclude>checkstyle:.*/Sh4jPosixTest\.java</exclude>
                        <exclude>checkstyle:.*/PosixRegressionTest\.java</exclude>
                        <exclude>checkstyle:.*/BuiltinMutationTest\.java</exclude>
                        <exclude>checkstyle:.*/ExecutorMutationTest\.java</exclude>
                        <exclude>checkstyle:.*/JobManagerTest\.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.1</version>
                <configuration>
                    <targetClasses>
                        <param>io.github.andreoss.sh4j.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.github.andreoss.sh4j.*</param>
                    </targetTests>
                    <excludedTestClasses>
                        <param>io.github.andreoss.sh4j.IntegrationTest</param>
                        <param>io.github.andreoss.sh4j.PosixConformanceTest</param>
                    </excludedTestClasses>
                    <threads>4</threads>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                        <param>CSV</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <timeoutConst>4000</timeoutConst>
                    <timeoutFactor>2.0</timeoutFactor>
                    <mutationThreshold>87</mutationThreshold>
                    <failWhenNoMutations>true</failWhenNoMutations>
                </configuration>
            </plugin>
    </plugins>
    </build>

    <profiles>
        <profile>
            <id>native-image</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <configuration>
                            <imageName>sh4j</imageName>
                            <mainClass>io.github.andreoss.sh4j.Main</mainClass>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
